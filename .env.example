# Web tuner build settings. Copy to .env.local (gitignored) and fill in.
# On Vercel, set the same names in the project's Environment Variables.

# Shared metadata cache the web tuner reads and writes, the same Supabase project
# the Apple TV app uses. The anon key is public by design: row level security on
# media_enrichments is what protects the table. Leave both empty and the tuner
# still works; TMDB enrichment is simply off and the console says so once.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional, local testing only. Where the tuner sends TMDB and OMDb lookups. Empty means
# same-origin /api/tmdb on the site, and https://nostalgex.app/api/tmdb on localhost.
VITE_TMDB_RELAY_URL=

# Relay keys for api/tmdb.js. Server side only: set them in Vercel's Environment
# Variables (or .env for `vercel dev`). The relay adds them; no client ever sees them.
# TMDB_API_KEY=
# OMDB_API_KEY=

# Devtools only (npm run snapshot / devtools), read from .env, never shipped.
# PLEX_URL=
# PLEX_TOKEN=
# TMDB_API_KEY=
